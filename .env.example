# GroupBuy - Environment Variables Template
# Copy this file to .env for local run or production deployment

# Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Neon Cloud PostgreSQL Configuration (Recommended for Cloud Hosting)
# Note: Neon requires sslmode=require for secure connections.
# Format: jdbc:postgresql://<endpoint-id>.neon.tech/<dbname>?sslmode=require
DB_URL=jdbc:postgresql://your-neon-endpoint.neon.tech/groupbuy_db?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# Local / Standard PostgreSQL Fallback Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groupbuy_db
DB_USER=groupbuy_user
DB_PASSWORD=your_local_password

# Payment & Webhook Configuration
# In production, provide a strong 32+ character random secret
APP_PAYMENT_WEBHOOK_SECRET=your_production_webhook_secret_32_chars_min

# Security & JWT Configuration
APP_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
APP_JWT_ACCESS_EXPIRATION_MS=900000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_JWT_ISSUER=groupbuy-api
# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Actuator & Observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# OpenAPI Documentation
SPRINGDOC_SWAGGER_UI_ENABLED=true
